{
  "name": "economic-intelligence-os",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "migrate": "node scripts/migrate.mjs",
    "test:production-smoke": "node scripts/production-smoke-regression.mjs && node scripts/production-smoke-boundary-regression.mjs && npm run test:release-evidence && npm run test:railway-config",
    "test:release-evidence": "node scripts/production-release-evidence-input-regression.mjs && node scripts/check-production-release-evidence.mjs --self-test",
    "test:railway-config": "node scripts/railway-config-regression.mjs",
    "test:production-readiness": "npm run typecheck && npm run test:production-smoke"
  },
  "dependencies": {
    "jose": "^6.0.0",
    "next": "^15.5.0",
    "pg": "^8.13.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
}
